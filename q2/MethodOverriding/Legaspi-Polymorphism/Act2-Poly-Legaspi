# What is duck typing, as explained in the video?
# Answer: Duck typing is where the type or class of an object is determined by its behavior.

# What did the Car class need to have so it could work inside the same loop as Dog and
# Cat, even if it does not inherit from the Animal class?
# Answer: The car needs to have the same method name as the Dog and Cat classes, which is the move() method.

class Car():
    def move(self):
        print("The car drives on the road.")

class Boat():
    def move(self):
        print("The boat sails on the water.")

class Drone():
    def move(self):
        print("The drone flies in the sky.")

def start_trip(vehicle):
    vehicle.move()

car = Car()
boat = Boat()
drone = Drone()

print("\nOutput:\n")
start_trip(car)
start_trip(boat)
start_trip(drone)